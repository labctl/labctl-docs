{
    "eslint.run": "onType",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "cSpell.words": [
      "clab",
      "containerlab",
      "dblclick",
      "golang",
      "labctl",
      "scrapligo",
      "srsim",
      "tmpl",
      "topo",
      "vars",
      "vitepress"
    ],
    "cSpell.ignorePaths": [
      ".git",
      ".vscode",
      "node_modules",
      "package.json",
      "package-lock.json",
      ".prettierrc",
      ".eslintrc.js"
    ],
    "[typescript]": {
      "editor.tabSize": 4,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[vue]": {
      "editor.tabSize": 4,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[json]": {
      "editor.tabSize": 4,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "cSpell.ignoreWords": [

    ],
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#198519",
      "titleBar.activeForeground": "#eee",
      "titleBar.inactiveBackground": "#103610",
  }
  }